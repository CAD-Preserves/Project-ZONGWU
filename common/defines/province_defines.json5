    "hill_miri_subansiri": {
      "abolition_note": "Claimed by British India under the 1914 Simla/McMahon alignment and by China within CHGIS 1911 Xizang, yet the Hill Miri, Tagin, and Nyishi clans across the Subansiri and Kamla gorges remained stateless and unadministered through the 1911-1912 Miri Mission and Republican period; incorporated into India's NEFA structure in 1951 and formally brought under the Subansiri Frontier Division in 1954 (still transitioning on 1 January 1953).",
      "active_years": [
        1912,
        1953
      ],
      "categories": [
        "tusi"
      ],
      "category": "tusi",
      "chronicle_path": "./chronicles/hill_miri_subansiri/",
      "de_facto_end_year": 1953,
      "de_facto_start_year": 1912,
