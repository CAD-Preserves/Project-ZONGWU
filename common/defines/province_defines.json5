    "kumul_khanate": {
      "abolition_note": "Semi-autonomous Uyghur jasagh khanate exempt from the 1884 Xinjiang provincehood reforms; ruled by Shah Maqsud (Maqsud Shah) until his death in 6 June 1930, when Governor Jin Shuren proclaimed gaituguiliu and divided the khanate into Hami, Yiwu, and Yihe counties. Briefly revived in 1931-1932 by Yulbars Khan and Khoja Niyaz behind heir Nasir Shah during the Kumul Rebellion before collapsing into the wider Xinjiang civil war.",
      "active_years": [
        1911,
        1932
      ],
      "categories": [
        "tusi"
      ],
      "category": "tusi",
      "chronicle_path": "./output/chronicles/tusi/tibet_himalaya_xinjiang/kumul_khanate/",
