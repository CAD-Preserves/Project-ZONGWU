  "romanisation_rules": {
    "japanese": "Modified Hepburn without macrons in canonical actor_id; standard Hepburn in display names.",
    "manchu": "Mollendorff transliteration.",
    "mandarin": "Hanyu Pinyin without tone marks for personal and place names unless an established English historical form is explicitly defined in actors.",
    "mongolian": "Standard Khalkha Cyrillic transliteration (BGN/PCGN) for modern names; established academic spelling for Bogd Khanate figures.",
    "russian_tuvan": "BGN/PCGN romanisation.",
    "tibetan": "THL simplified phonetic transcription paired with Wylie in aliases."
  }
