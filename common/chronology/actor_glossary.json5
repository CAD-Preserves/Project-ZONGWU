  "calendar_conversions": {
    "lunar_chinese_or_tibetan_rabjung": "Convert astronomically to Gregorian GMT+0; if only lunar month/year is known, emit 00 Month YYYY or 00 Unknown YYYY.",
    "minguo": "1911 + minguo_year (Minguo 1 = 1912)",
    "olnoo_orgogdson": "1910 + mongol_year (Olnoo Orgogdson 1 = 1911)",
    "russian_julian_pre_1918_02": "Add 13 days for dates between 01 January 1912 and 31 January 1918 Julian to align with Gregorian GMT+0.",
    "showa": "1925 + showa_year (Showa 1 = 1926)",
    "taisho": "1911 + taisho_year (Taisho 1 = 1912)"
  },
