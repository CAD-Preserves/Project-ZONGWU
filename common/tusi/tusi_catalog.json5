    "conventions": {
      "start_year": "First year >= 1912 in which the polity existed as a recognised or autonomous Tusi or frontier entity (e.g. 1918 for restored Derge).",
      "end_year": "Last inclusive 1 January year in which the polity was still active (e.g. 1953 if abolished on 23 Jan 1953 or later; 1952 if abolished in late 1952; 1951 if abolished on 25 Dec 1951).",
      "geometry_mode": "chgis_direct uses verified CHGIS V6 1911 polygons via chgis_unit_ids; kriging_modelled uses seat coordinates and known_settlements for spatial interpolation."
